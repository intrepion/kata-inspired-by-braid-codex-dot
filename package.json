{
  "name": "the-hours-we-keep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && node scripts/verify-arcade.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node scripts/serve.mjs",
    "check:arcade": "node scripts/verify-arcade.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
